{
  "extends": "@nimoh-digital-solutions/tsconfig/base.json",
  "compilerOptions": {
    // Path Aliases (must match vite.config.ts)
    "baseUrl": "src",
    "paths": {
      "@assets": ["assets"],
      "@assets/*": ["assets/*"],
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@configs": ["configs"],
      "@configs/*": ["configs/*"],
      "@contexts": ["contexts"],
      "@contexts/*": ["contexts/*"],
      "@data": ["data"],
      "@data/*": ["data/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@layouts": ["layouts"],
      "@layouts/*": ["layouts/*"],
      "@pages": ["pages"],
      "@pages/*": ["pages/*"],
      "@routes": ["routes"],
      "@routes/*": ["routes/*"],
      "@styles": ["styles"],
      "@styles/*": ["styles/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@features": ["features"],
      "@features/*": ["features/*"],
      "@test": ["test"],
      "@test/*": ["test/*"],
      // Shared package alias — active when project has packages/shared/
      // (e.g. via create-nimoh-app --mobile). Safe to leave when packages/shared/ doesn't exist.
      "@shared/*": ["../../packages/shared/src/*"],
      // Workspace package resolution — points tsc to source so dist/ isn't required
      "@nimoh-digital-solutions/tast-utils": ["../packages/tast-utils/src/index.ts"],
      "@nimoh-digital-solutions/tast-hooks": ["../packages/tast-hooks/src/index.ts"],
      "@nimoh-digital-solutions/tast-ui": ["../packages/tast-ui/src/index.ts"]
    }
  },
  "include": ["src", "../packages/shared/src"],
  "exclude": ["node_modules", "dist", "../packages/shared/src/**/__tests__"]
}
