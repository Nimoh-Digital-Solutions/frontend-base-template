{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Emit
    "noEmit": true,
    // Interop
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    // Path Aliases (must match vite.config.ts)
    "baseUrl": "src",
    "paths": {
      "@assets": ["assets"],
      "@assets/*": ["assets/*"],
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@configs": ["configs"],
      "@configs/*": ["configs/*"],
      "@contexts": ["contexts"],
      "@contexts/*": ["contexts/*"],
      "@data": ["data"],
      "@data/*": ["data/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@layouts": ["layouts"],
      "@layouts/*": ["layouts/*"],
      "@pages": ["pages"],
      "@pages/*": ["pages/*"],
      "@routes": ["routes"],
      "@routes/*": ["routes/*"],
      "@styles": ["styles"],
      "@styles/*": ["styles/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"],
      "@services": ["services"],
      "@services/*": ["services/*"],
      "@features": ["features"],
      "@features/*": ["features/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
