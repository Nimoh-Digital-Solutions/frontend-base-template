{
  "name": "reactstarterkit",
  "version": "1.0.0",
  "description": "A modern React starter kit with TypeScript, Vite, SCSS, and comprehensive tooling for building scalable applications",
  "author": {
    "name": "Matthew Venter",
    "email": "matthewcpventer@gmail.com"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "yarn audit --level high",
    "check": "yarn audit --level high && yarn type-check && yarn lint && yarn stylelint && yarn test:run",
    "check:fix": "yarn lint:fix && yarn stylelint:fix && yarn format",
    "setup": "node scripts/setup.js",
    "setup:pwa": "node scripts/setup-pwa.js",
    "setup:testing": "node scripts/setup-testing.js",
    "setup:husky": "node scripts/setup-husky.js",
    "setup:docker": "node scripts/setup-docker.js",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@nimoh-digital-solutions/eslint-config": "^1.0.0",
    "@nimoh-digital-solutions/stylelint-config": "^1.0.0",
    "@nimoh-digital-solutions/tsconfig": "^1.0.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^8.57.1",
    "@stylistic/stylelint-plugin": "^3.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.5.0",
    "@types/node": "^24.0.14",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.1.0",
    "postcss-pxtorem": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.2.5",
    "prompts": "^2.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.75.0",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-scss": "^6.12.1",
    "typescript": "^5.3.3",
    "vite": "^7.0.5",
    "vite-plugin-checker": "^0.10.0",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
