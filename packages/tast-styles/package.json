{
  "name": "@nimoh-digital-solutions/tast-styles",
  "version": "1.1.1",
  "description": "SCSS design tokens, mixins, and base styles for the tast design system",
  "keywords": [
    "scss",
    "design-tokens",
    "styles",
    "tast"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.scss",
    "./abstracts/*": "./src/abstracts/*",
    "./base/*": "./src/base/*",
    "./themes/*": "./src/themes/*",
    "./layout/*": "./src/layout/*",
    "./pages/*": "./src/pages/*",
    "./vendors/*": "./src/vendors/*",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "open-props": "^1.7.23"
  }
}
