{
  "name": "@nimoh-digital-solutions/tast-utils",
  "version": "1.1.5",
  "description": "Utility functions, types, and HTTP client for tast projects",
  "keywords": [
    "utils",
    "http",
    "types",
    "tast"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nimoh-digital-solutions/tsconfig": "workspace:^",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
